# SchemeFinder Environment Variables
# (Optional) OpenSearch URL - defaults to http://localhost:9200
OPENSEARCH_URL=http://localhost:9200

# (Optional) Local HTTP Server Port - defaults to 8000
PORT=8000

# (Optional) Cloud LLM API Keys (If provided, upgrades Strands Agent to Cloud LLM reasoning)
# GEMINI_API_KEY=your_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
